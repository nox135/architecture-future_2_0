@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(patient, "Пациент", "Использует мобильное приложение/веб-портал")
Person(doctor, "Врач", "Использует внутреннюю систему")
Person(analyst, "Бизнес-аналитик", "Использует Портал Данных")
Person(fintech_user, "Клиент Финтеха", "Пользуется банковскими услугами")
System_Ext(external_partners, "Внешние Партнеры", "Страховые компании, Аптеки, Производители оборудования")


System_Boundary(future_platform, "Платформа Будущее 2.0") {

    Container(api_gateway, "API Gateway / BFF", "Go/Java", "Единая точка входа")
    Container(auth_service, "Сервис Аутентификации", "Keycloak/OIDC", "Аутентификация и роли")
    Container(event_bus, "Шина Событий", "Kafka/Pulsar", "Обмен событиями между доменами")

    System_Boundary(medicine_domain, "Домен Медицина") {
        Container(emr_service, "Сервис ЭМК (EMR)", "Java/Spring", "Электронные медицинские карты")
        Container(diagnostics_service, "Сервис Диагностики", "Python", "Работа с оборудованием")
        ContainerDb(med_db, "Медицинская БД", "PostgreSQL", "Данные пациентов")
    }

    System_Boundary(fintech_domain, "Домен Финтех") {
        Container(banking_service, "Основной Банковский Сервис", "Go", "Счета и транзакции")
        Container(credit_service, "Кредитный Сервис", "Go", "Заявки на кредит")
        ContainerDb(fin_db, "Финтех БД", "PostgreSQL/CockroachDB", "Финансовые данные")
    }

    System_Boundary(ai_domain, "Домен ИИ") {
        Container(ai_model_service, "Сервис ИИ (Inference)", "Python", "Прогнозы")
        Container(ai_training_pipeline, "Пайплайн Обучения", "Kubeflow", "Обучение моделей")
        ContainerDb(model_registry, "Реестр Моделей", "MLflow", "Версии моделей")
    }

    System_Boundary(data_platform, "Платформа Данных и Аналитики") {
        Container(stream_processing, "Потоковый Процессор", "Flink/Spark", "Проверки и трансформации")
        ContainerDb(data_lake, "Озеро Данных", "S3/Delta Lake", "История и сырые данные")
        ContainerDb(analytical_db, "Аналитическая БД", "ClickHouse/Greenplum", "Витрины и отчеты")
        Container(data_portal_backend, "Бэкенд Портала Данных", "Python/FastAPI", "API аналитики")
        Container(data_portal_ui, "UI Портала Данных", "React/Vue", "Self-service отчеты")
    }

    System_Boundary(legacy_zone, "Legacy зона") {
        Container(legacy_bridge, "Legacy Bridge", "Apache Camel + CDC", "Переходный слой. Выводится из эксплуатации после 3х лет")
        Container(legacy_esb, "Legacy ESB", "Apache Camel", "Полный вывод после 3х лет")
        ContainerDb(legacy_dwh, "Legacy DWH", "SQL Server 2008", "Только чтение после миграции")
    }
}

' Расстановка блоков
Lay_D(api_gateway, auth_service)
Lay_D(auth_service, event_bus)

Lay_D(event_bus, emr_service)
Lay_R(emr_service, banking_service)
Lay_R(banking_service, ai_model_service)
Lay_R(ai_model_service, stream_processing)

Lay_D(emr_service, diagnostics_service)
Lay_D(diagnostics_service, med_db)

Lay_D(banking_service, credit_service)
Lay_D(credit_service, fin_db)

Lay_D(ai_model_service, ai_training_pipeline)
Lay_D(ai_training_pipeline, model_registry)

Lay_D(stream_processing, data_lake)
Lay_D(data_lake, analytical_db)
Lay_D(analytical_db, data_portal_backend)
Lay_D(data_portal_backend, data_portal_ui)

Lay_L(emr_service, legacy_bridge)
Lay_D(legacy_bridge, legacy_esb)
Lay_D(legacy_esb, legacy_dwh)

' Пользователи
Rel(patient, api_gateway, "Использует")
Rel(doctor, api_gateway, "Использует")
Rel(fintech_user, api_gateway, "Использует")
Rel(analyst, data_portal_ui, "Использует")
Rel(external_partners, api_gateway, "Интеграция API")

' Основные связи
Rel(api_gateway, auth_service, "Аутентификация")
Rel(api_gateway, emr_service, "Запросы")
Rel(api_gateway, banking_service, "Запросы")

Rel(emr_service, med_db, "Данные")
Rel(diagnostics_service, med_db, "Запись")

Rel(banking_service, fin_db, "Данные")
Rel(credit_service, fin_db, "Данные")

Rel(emr_service, event_bus, "События")
Rel(diagnostics_service, event_bus, "События")
Rel(banking_service, event_bus, "События")
Rel(credit_service, event_bus, "События")
Rel(ai_model_service, event_bus, "Читает")

Rel(stream_processing, event_bus, "Читает")
Rel(stream_processing, data_lake, "Запись")
Rel(stream_processing, analytical_db, "Витрины")

Rel(data_portal_ui, data_portal_backend, "API")
Rel(data_portal_backend, analytical_db, "SQL")
Rel(data_portal_backend, data_lake, "История")

Rel(legacy_dwh, legacy_bridge, "CDC")
Rel(legacy_esb, legacy_bridge, "Интеграции")
Rel(legacy_bridge, event_bus, "События")
Rel(legacy_bridge, emr_service, "Логика")
Rel(legacy_bridge, banking_service, "Логика")

@enduml